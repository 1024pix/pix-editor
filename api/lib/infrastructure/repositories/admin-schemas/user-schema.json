{
  "$schema": "./$schema.json",
  "id": "user-schema",
  "label": "Utilisateurs",
  "entityName": "users",
  "editable": true,
  "deletable": true,
  "creatable": true,
  "defaultSort": {
    "field": "id",
    "direction": "asc"
  },
  "fields": [
    {
      "key": "id",
      "label": "Identifiant",
      "type": "number",
      "readonly": true
    },
    {
      "key": "name",
      "label": "Nom",
      "type": "string"
    },
    {
      "key": "trigram",
      "label": "Trigramme",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    {
      "key": "apiKey",
      "label": "Clé API",
      "type": "secret",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "sortable": false
    },
    {
      "key": "access",
      "label": "Niveau d'accès",
      "type": "enum",
      "options": [
        {
          "value": "admin",
          "label": "Administrateur"
        },
        {
          "value": "editor",
          "label": "Éditeur"
        },
        {
          "value": "readonly",
          "label": "Lecture seule"
        },
        {
          "value": "readpixonly",
          "label": "Lecture Pix"
        },
        {
          "value": "replicator",
          "label": "Déclinateur"
        }
      ]
    }
  ]
}
