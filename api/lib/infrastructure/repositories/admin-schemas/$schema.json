{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Admin entity JSON schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "entityName": {
      "type": "string"
    },
    "editable": {
      "type": "boolean"
    },
    "deletable": {
      "type": "boolean"
    },
    "creatable": {
      "type": "boolean"
    },
    "defaultSort": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "direction": {
          "enum": ["asc", "desc"]
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": ["string", "number", "enum", "secret", "timestamp"]
          },
          "pattern": {
            "type": "string"
          },
          "readonly": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": ["string", "null"]
                },
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": ["value", "label"]
            }
          }
        },
        "additionalProperties": false,
        "required": ["key", "label", "type"]
      }
    }
  },
  "additionalProperties": false,
  "required": ["id", "label", "entityName", "editable", "deletable", "creatable", "fields", "defaultSort"]
}
