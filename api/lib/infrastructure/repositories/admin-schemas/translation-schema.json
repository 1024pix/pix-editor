{
  "$schema": "./$schema.json",
  "id": "translation-schema",
  "label": "Traductions",
  "entityName": "translations",
  "editable": false,
  "deletable": false,
  "creatable": true,
  "defaultSort": {
    "field": "key",
    "direction": "asc"
  },
  "fields": [
    {
      "key": "key",
      "label": "Clé",
      "type": "string",
      "pattern": "^\\w+\\.\\w+\\.\\w+$"
    },
    {
      "key": "locale",
      "label": "Locale",
      "type": "string"
    },
    {
      "key": "value",
      "label": "Contenu",
      "type": "string"
    },
    {
      "key": "model",
      "label": "Modèle",
      "type": "enum",
      "readonly": true,
      "options": [
        {
          "label": "Épreuve",
          "value": "challenge"
        },
        {
          "label": "Acquis",
          "value": "skill"
        },
        {
          "label": "Sujet",
          "value": "tube"
        },
        {
          "label": "Thématique",
          "value": "thematic"
        },
        {
          "label": "Compétence",
          "value": "competence"
        },
        {
          "label": "Domaine",
          "value": "area"
        }
      ]
    },
    {
      "key": "entityId",
      "label": "Identifiant de l'entité",
      "type": "string",
      "readonly": true
    }
  ]
}
