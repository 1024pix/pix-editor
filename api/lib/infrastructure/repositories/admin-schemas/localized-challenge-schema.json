{
  "$schema": "./$schema.json",
  "id": "localized-challenge-schema",
  "label": "Épreuves traduites",
  "entityName": "localized_challenges",
  "editable": false,
  "deletable": false,
  "creatable": false,
  "primaryKey": "id",
  "defaultSort": {
    "field": "id",
    "direction": "asc"
  },
  "fields": [
    {
      "key": "id",
      "label": "Identifiant",
      "type": "number"
    },
    {
      "key": "geography",
      "label": "Géographie",
      "type": "string"
    },
    {
      "key": "embedUrl",
      "label": "URL de l'embed",
      "type": "string",
      "sortable": false
    },
    {
      "key": "status",
      "label": "Statut",
      "type": "enum",
      "options": [
        {
          "label": "En prod",
          "value": "validé"
        },
        {
          "label": "En pause",
          "value": "proposé"
        },
        {
          "label": "Aucun",
          "value": null
        }
      ]
    },
    {
      "key": "locale",
      "label": "Locale",
      "type": "string"
    },
    {
      "key": "challengeId",
      "label": "Identifiant de l'épreuve",
      "type": "string"
    }
  ]
}
