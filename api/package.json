{
  "name": "learning-content-api",
  "version": "4.59.0",
  "description": "API permettant d'interagir avec le référentiel de contenu Pix",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^24.15.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "coverage": "NODE_ENV=test nyc --silent _mocha --recursive --exit --reporter dot tests && nyc report --reporter=lcov --report-dir=./coverage",
    "db:new-migration": "npx knex --knexfile db/knexfile.js migrate:make $migrationname",
    "db:create": "node --env-file-if-exists=.env scripts/database/create-database",
    "db:delete": "node --env-file-if-exists=.env scripts/database/drop-database",
    "db:empty": "node --env-file-if-exists=.env scripts/database/empty-database.js",
    "db:migrate": "knex --knexfile db/knexfile.js migrate:latest",
    "db:prepare": "npm run db:delete && npm run db:create && npm run db:migrate",
    "db:seed": "knex --knexfile db/knexfile.js seed:run",
    "db:reset": "npm run db:prepare && npm run db:seed",
    "db:rollback:latest": "knex --knexfile db/knexfile.js migrate:down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preinstall": "git config core.hooksPath .githooks || true",
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "nodemon --env-file-if-exists=.env --ext js,cjs,json,jsx --signal SIGTERM index.js",
    "test": "NODE_ENV=test npm run db:prepare && npm run test:api",
    "test:api": "NODE_ENV=test vitest run",
    "test:api:unit": "NODE_ENV=test vitest run tests/unit/",
    "test:api:integration": "NODE_ENV=test vitest run tests/integration/",
    "test:api:acceptance": "NODE_ENV=test vitest run tests/acceptance/",
    "test:api:scripts": "NODE_ENV=test vitest run tests/scripts/",
    "test:api:debug": "NODE_ENV=test vitest run --inspect-brk=9229",
    "test:api:watch": "NODE_ENV=test vitest",
    "test:lint": "npm test && npm run lint",
    "postdeploy": "npm run db:migrate",
    "scalingo-post-ra-creation": "npm run postdeploy && npm run db:seed"
  },
  "author": "GIP Pix",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@1024pix/epreuves-components": "4.26.5",
    "@1024pix/oppsy": "1.0.2",
    "@adminjs/hapi": "7.1.0",
    "@adminjs/sequelize": "4.1.1",
    "@googleapis/sheets": "18.1.0",
    "@hapi/boom": "10.0.1",
    "@hapi/cookie": "12.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "@joi/date": "3.0.0",
    "@octokit/rest": "22.0.1",
    "adminjs": "7.8.17",
    "archiver": "8.0.0",
    "base-x": "5.0.1",
    "blipp": "4.0.2",
    "bull": "4.16.5",
    "countries-list": "3.4.1",
    "diff": "9.0.0",
    "fast-csv": "5.0.8",
    "fetch-cookie": "3.2.0",
    "file-saver": "2.0.5",
    "html-validate": "11.16.2",
    "joi": "18.2.9",
    "js-crypto-random": "1.0.5",
    "json-stream-es": "1.2.1",
    "jsonapi-serializer": "3.6.9",
    "knex": "3.3.0",
    "lodash": "4.18.1",
    "micromatch": "4.0.8",
    "node-cache": "5.1.2",
    "p-map": "7.0.8",
    "pg": "8.23.1",
    "pg-query-stream": "4.17.1",
    "phrase-js": "3.27.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "qs": "6.16.0",
    "sequelize": "6.37.8",
    "shiki": "4.5.0",
    "showdown": "2.1.0",
    "standardwebhooks": "1.1.1",
    "tough-cookie": "6.0.2",
    "url-regex-safe": "4.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "dayjs": "1.11.23",
    "eslint": "10.12.0",
    "eslint-plugin-mocha": "12.0.2",
    "flush-write-stream": "2.0.0",
    "form-data": "4.0.6",
    "globals": "17.13.0",
    "nock": "15.0.1",
    "nodemon": "3.1.14",
    "papaparse": "5.7.0",
    "parse-multipart-data": "1.5.0",
    "pg-boss": "12.35.1",
    "split2": "4.2.0",
    "vitest": "4.1.11",
    "yargs": "18.2.0"
  },
  "overrides": {
    "tough-cookie": "6.0.2",
    "@rollup/plugin-commonjs": "29.0.3"
  }
}
