          "title": "Quiz onigiri",
          "components": [
            {
              "type": "element",
              "element": {
                "id": "c82ecef9-14e6-406f-8685-fd04010944d5",
                "type": "qcu",
                "instruction": "<p>Quelle feuille enveloppe traditionnellement un onigiri ?</p>",
                "hasShortProposals": false,
                "proposals": [
                  {
                    "id": "1",
                    "content": "Une feuille de nori",
                    "feedback": {
                      "state": "Correct&#8239;!",
                      "diagnosis": "<p>L’algue nori garde le riz en place et évite de coller les doigts.</p>"
                    }
                  },
                  {
                    "id": "2",
                    "content": "Une feuille de brick",
                    "feedback": {
                      "state": "Incorrect.",
                      "diagnosis": "<p>La brick, c’est pour les samoussas. L’onigiri préfère l’algue nori.</p>"
                    }
                  },
                  {
                    "id": "3",
                    "content": "Une feuille de papier sulfurisé",
                    "feedback": {
                      "state": "Incorrect.",
                      "diagnosis": "<p>Pratique pour la cuisson, beaucoup moins pour la dégustation. La bonne réponse est l’algue nori.</p>"
                    }
                  }
                ],
                "solution": "1"
              }
            }
          ]
        }
      ]
    }
  ],
  "glossary": [
    {
      "word": "nori",
      "definition": "<p>Algue séchée et pressée en feuilles fines, utilisée pour envelopper les onigiris et les makis.</p>"
    },
    {
      "word": "umeboshi",
      "definition": "<p>Prune japonaise salée et séchée, garniture traditionnelle de l’onigiri.</p>"
