                "type": "text",
                "tag": " ",
                "content": "<p>Carton n°12 : vaisselle fragile (encore lui&#8239;? Éric l’a étiqueté deux fois).</p>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "bf8aebaf-f4c8-4387-b95e-70617f062009",
      "type": "practise",
      "grains": [
        {
          "id": "7a874ba5-8f4f-48a3-9b40-eb6d565ef8e4",
          "type": "activity",
          "title": "Le chargement du camion",
          "components": [
            {
              "type": "element",
              "element": {
                "id": "d94fee9d-487f-44f5-9abc-53f4ed4785ef",
                "type": "qcu",
                "instruction": "<p>Quel carton Éric doit-il charger en dernier dans le camion ?</p>",
                "hasShortProposals": false,
                "proposals": [
                  {
                    "id": "1",
                    "content": "Le carton avec la cafetière et les draps",
                    "feedback": {
                      "state": "Correct&#8239;!",
                      "diagnosis": "<p>Chargé en dernier, il sera déchargé en premier : Éric pourra prendre un café et dormir dès le premier soir.</p>"
                    }
                  },
                  {
                    "id": "2",
                    "content": "Le carton n°12 de vaisselle fragile",
                    "feedback": {
                      "state": "Incorrect.",
                      "diagnosis": "<p>La vaisselle peut attendre. Et puis, lequel des deux cartons n°12&#8239;?</p>"
                    }
                  },
                  {
                    "id": "3",
                    "content": "Le canapé",
                    "feedback": {
                      "state": "Incorrect.",
                      "diagnosis": "<p>Les meubles lourds se chargent en premier, au fond du camion.</p>"
                    }
                  }
                ],
                "solution": "1"
              }
            }
          ]
        }
      ]
    }
  ],
  "glossary": [
    {
      "word": "diable",
      "definition": "<p>Chariot à deux roues utilisé pour transporter des cartons ou des meubles lourds.</p>"
    }
