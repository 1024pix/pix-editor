      "grains": [
        {
          "id": "60ca329e-f314-4033-8c63-fd151a5bd8d1",
          "type": "discovery",
          "title": "Éric demande conseil",
          "components": [
            {
              "type": "element",
              "element": {
                "id": "f62cbf2f-c3db-4e51-b12f-f1ecb322ee05",
                "type": "text",
                "tag": " ",
                "content": "<p>Éric quitte son deux-pièces pour un appartement plus grand. Avant de remplir le premier carton, il demande de l’aide à DéménagIA, un assistant conversationnel.</p>"
              }
            },
            {
              "type": "element",
              "element": {
                "id": "e0126fec-e96f-4482-bc7c-fea3bf8bc457",
                "type": "custom",
                "instruction": "",
                "tagName": "llm-messages",
                "props": {
                  "messages": [
                    {
                      "direction": "outbound",
                      "content": "Salut DéménagIA ! Je déménage dans trois semaines, par où je commence ?"
                    },
                    {
                      "direction": "inbound",
                      "content": "<strong>Bonjour Éric !</strong><br>Commencez par trier : ce que vous gardez, donnez ou jetez. Ensuite, réservez le camion et prévenez votre propriétaire."
                    },
                    {
                      "direction": "outbound",
                      "content": "Combien de cartons je dois prévoir ?"
                    },
                    {
                      "direction": "inbound",
                      "content": "Comptez environ 10 cartons par pièce. Et surtout, numérotez-les tous différemment !"
                    },
                    {
                      "direction": "outbound",
                      "content": "Et je charge quoi en dernier dans le camion ?"
                    },
                    {
                      "direction": "inbound",
                      "content": "Le carton de première nécessité : cafetière, draps, brosse à dents et chargeur de téléphone. C’est le premier que vous ouvrirez en arrivant."
                    }
                  ]
                },
                "title": "",
                "functionalInstruction": ""
              }
            }
          ]
        }
      ]
    },
    {
      "id": "22bd7f83-3319-414a-a452-90962f88d91c",
      "type": "explore-to-understand",
      "grains": [
