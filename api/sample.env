# This file is the minimal confuguration file used by Dotenv to define the
# environment variables on localhost.
#
# Instructions:
#   1. copy this file as `.env`
#   2. edit the `.env` file with working values
#   3. uncomment the lines to activate or configure associated features
#
# Sections (displayed in sorted in alphabtic order):
#   - server
#   - databases
#   - learning content
#   - logging
#   - storage
#   - pix api
#   - pg-boss
#   - oh dear
# Line size max: 80 characters.

# ======
# SERVER
# ======

# Enable or disable the logging of all the requests of the API.
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# ENABLE_REQUEST_MONITORING=true

# Admin session cookie password
#
# presence: required
# type: 32 length min String
# default: none
ADMIN_COOKIE_PASSWORD=aMoreThan32CharLongStringForExample

# Maximum size allowed for translations import file
#
# presence: optional
# type: Number (in bytes)
# default: 209715200 bytes
# IMPORT_TRANSLATIONS_FILE_MAX_SIZE=2097152

# =========
# DATABASES
# =========

# URL of the PostgreSQL databse used for storing users data (filled-in or
# generated).
#
# If not present, the application will crash during API boostrap.
#
# presence: required
# type: Url
# default: none
DATABASE_URL=postgresql://postgres@localhost:5444/pix_lcms

# URL of the PostgreSQL databse used for API local testing.
#
# If not present, the tests will fail.
#
# presence: required
# type: Url
# default: none
TEST_DATABASE_URL=postgresql://postgres@localhost:5444/pix_lcms_test

# Connexion pool used by Knex. By default, Knex has has a default setting of a
# min: 2, max: 10 for the PG library. On LCMS API, we override the max default
# value to 4.
#
# See https://knexjs.org/#Installation-pooling
#
# presence: optional
# type: positive integer
# default: 4
# DATABASE_CONNECTION_POOL_MAX_SIZE

# Enable or disable SSL on database connection
#
# See https://github.com/knex/knex/blob/6ee3f94d1a694d4a13e50a81a37d27cad45e795b/types/index.d.ts#L2603
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# DATABASE_SSL_ENABLED=true

# Passing an asyncStackTraces: `true` flag on your initialization object will
# turn on stack trace capture for all query builders, raw queries and schema
# builders.
#
# See:
# - https://knexjs.org/#Installation-asyncStackTraces
# - https://github.com/knex/knex/blob/6ee3f94d1a694d4a13e50a81a37d27cad45e795b/types/index.d.ts#L2311
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# KNEX_ASYNC_STACKTRACE_ENABLED=true

# =======
# LOGGING
# =======

# Enable or disable the logging of the API.
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
LOG_ENABLED=true

# Set logging level of the API.
#
# presence: optional
# type: String
# default: "info"
# LOG_LEVEL=debug

# Log for humans
#
# Make log human-friendly:
# - color logs
# - display time of the day in HH:MM:SS format
# - skip process id and hostname
# - synchronous logs (decrease performance)
# Do NOT use if logs are to be processed by a log processing pipeline
#
# Sample output: [8:27:12] INFO: Connected to server
# presence: optional
# type: String
LOG_FOR_HUMANS=true

# Logs for humans format
#
# "compact": Always display logs on a single line with key information.
#
# presence: optional
# type: String
# LOG_FOR_HUMANS_FORMAT=compact

# Log operations metrics
#
# Log core container metrics: CPU, memory, load-average, http calls...
# Sample output: {"event":"ops","timestamp":1630419363680,"host":"pix-api-production-web-2","pid":22,"os":{"load":[2.16,1.97,1.85],"mem":{"total":42185723904,"free":6782152704},"uptime":8208319.46},"proc":{"uptime":81367.686662047,"mem":{"rss":196128768,"heapTotal":109948928,"heapUsed":104404328,"external":6004718,"arrayBuffers":4416211},"delay":0.11345672607421875},"load":{"requests":{"21344":{"total":55,"disconnects":0,"statusCodes":{"200":43,"201":10,"204":1,"401":1}}},"responseTimes":{"21344":{"avg":19.472727272727273,"max":64}},"sockets":{"http":{"total":0},"https":{"total":0}}}}
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# LOG_OPS_METRICS=true

# Log operations sample rate
#
# Time (seconds) each logging
#
# presence: optional
# type: positive integer
# default: 15
# OPS_EVENT_EACH_SECONDS=1

# Enables debug log level for a list of sections.
# Sections must be given separated by commas.
# micromatch syntax may be used to match several sections.
# presence: optional
# type: string
# default: none
# LOG_DEBUG=learningcontent:*,foo,bar


# =====================================================
# STORAGE : only Swift buckets are supported, not S3  =
# =====================================================

# Bucket url
#
# If not present the application will crash during saving challenge with
# attachment.
#
# presence: required
# type: String
# default: none
# sample: https://some.storage.io/my-bucket/
STORAGE_POST=

# Bucket name
#
# If not present the application will crash during saving challenge with
# attachment.
#
# presence: required
# type: String
# default: none
# sample: my-swift-bucket
STORAGE_BUCKET=

# Bucket username
#
# If not present the application will crash during saving challenge with
# attachment.
#
# presence: required
# type: String
# default: none
# sample: user1
STORAGE_USER=

# Bucket password
#
# If not present the application will crash during saving challenge with
# attachment.
#
# presence: required
# type: String
# default: none
# sample: secret
STORAGE_PASSWORD=

# Tenant identifier
#
# If not present the application will crash during saving challenge with
# attachment.
#
# presence: required
# type: String
# default: none
# sample: 123456789
STORAGE_TENANT=

# Token endpoint
#
# If not present the application will crash during saving challenge with
# attachment.
#
# presence: required
# type: String
# default: none
# sample: https://auth.cloud.ovh.net/v3/auth/tokens
STORAGE_AUTH=

# ================
# PIX BUSINESS API
# ================

# Pix API base url used to connect to Pix API to refresh the cache.
#
# If not present the application cannot refresh the cache.
#
# presence: required
# type: Url
# default: none
PIX_API_BASEURL=

# Pix api user email used to connect to Pix API to refresh the cache.
# The user shall have admin rights.
#
# If not present the application cannot refresh the cache.
#
# presence: required
# type: String
# default: none
PIX_API_USER_EMAIL=

# Pix api user password used to connect to Pix API to refresh the cache.
# The user shall have admin rights.
#
# If not present the application cannot refresh the cache.
#
# presence: required
# type: String
# default: none
PIX_API_USER_PASSWORD=

# ========
# PIX APP
# ========
# Pix APP base url used to preview challenges and draft modules for France.
#
# If not present the application cannot preview challenges or draft modules.
#
# presence: required
# type: Url
# default: none
PIX_APP_RECETTE_BASEURL_FR=

# Pix APP base url used to preview translated challenges and draft modules for other languages/countries.
#
# If not present the application cannot preview translated challenges or draft modules.
#
# presence: required
# type: Url
# default: none
PIX_APP_RECETTE_BASEURL_ORG=

# Pix APP base url used to preview modules for France.
#
# If not present the application cannot preview modules.
#
# presence: required
# type: Url
# default: none
PIX_APP_PRODUCTION_BASEURL_FR=

# Pix APP base url used to preview translated modules for other languages/countries.
#
# If not present the application cannot translated modules.
#
# presence: required
# type: Url
# default: none
PIX_APP_PRODUCTION_BASEURL_ORG=


# ==============
# SCHEDULED JOBS
# ==============

# URL of the Redis server used for handling scheduled jobs.
#
# If not present, the application will not create periodic releases.
#
# presence: optional
# type: Url
# default: none
REDIS_URL=redis://localhost:6380

# Cron date/time scheduled time to create periodic release.
# Europe/Paris timezone is used as reference.
#
# If not present, the application will not create periodic releases.
#
# presence: optional
# type: Cron expression
# default: none
CREATE_RELEASE_TIME=0 0 * * *

# Cron date/time scheduled time to export external url list.
# Europe/Paris timezone is used as reference.
#
# If not present, the application will not export external url list
#
# presence: optional
# type: Cron expression
# default: none
EXPORT_EXTERNAL_URL_LIST_TIME=0 9 1 * *

# Cron date/time scheduled time to handle releases cleaning and retention in PG table.
# Europe/Paris timezone is used as reference.
#
# If not present, the application will not clean the table.
#
# presence: optional
# type: Cron expression
# default: none
CLEAN_RELEASES_TABLE_TIME=3 23 5 * *

# The total number of attempts to try the job until it completes.
#
# See https://github.com/OptimalBits/bull/blob/ad3b796d75d0a0cd8b6d71c5e756640bc8d2d992/REFERENCE.md#queueadd
#
# presence: optional
# type: positive integer
# default: 4
# CREATE_RELEASE_ATTEMPTS=2

# ============
# NOTIFICATION
# ============

# Enable or disable the slack notification.
#
# presence: required
# type: Boolean
# default: `undefined` (`false`)
# NOTIFICATIONS_SLACK_ENABLE=false

# URL of the Slack webhook.
#
# If not present, the application will not send notification after creating
# release.
#
# presence: required only if NOTIFICATIONS_SLACK_ENABLE=true
# type: Url
# default: none
# NOTIFICATIONS_SLACK_WEBHOOK_URL=

# =================
# URLS CHECKING JOB
# =================

# Job toggle
#
# If true job is scheduled, else is not
# type: String
# default: 'false'
START_CHECK_URL_JOB=false

# Google auth credentials
#
# If not present, the "URL checking" scheduled job will fail but the
# applications (API and UI) could run successfully.
#
# Stringified auth json
#
# presence: required for this job
# type: String
# default: '{}'
GOOGLE_AUTH_CREDENTIALS=

# Google Spreadsheet ID
#
# If not present, the "URL checking" scheduled job will fail but the
# applications (API and UI) could run successfully.
#
# Find it on the URL of the google sheet target
#
# presence: required for this job
# type: String
# default: none
CHECK_URLS_SPREADSHEET_ID=

# Name of the sheet tab for the challenges result
#
# If not present, the "URL checking" scheduled job will fail but the
# applications (API and UI) could run successfully.
#
# presence: required for this job
# type: String
# default: none
CHECK_URLS_CHALLENGES_SHEET_NAME=

# Name of the sheet tab for the tutorials result
#
# If not present, the "URL checking" scheduled job will fail but the
# applications (API and UI) could run successfully.
#
# presence: required for this job
# type: String
# default: none
CHECK_URLS_TUTORIALS_SHEET_NAME=

# =================
# EXPORT EXTERNAL URLS JOB
# =================

# Google Spreadsheet ID
#
# If not present, the "export external URLs" scheduled job will fail but the
# applications (API and UI) could run successfully.
#
# Find it on the URL of the google sheet target
#
# presence: required for this job
# type: String
# default: none
EXPORT_EXTERNAL_URLS_LIST_SPREADSHEET_ID=

# ===================================
# SENTRY (ERROR LOGGING & MANAGEMENT)
# ===================================

# Enable or disable Sentry error management tool.
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# SENTRY_ENABLED=true

# Sentry Data Source Name.
#
# See https://docs.sentry.io/product/sentry-basics/dsn-explainer/
#
# presence: optional
# type: URL
# default: none
# example: https://public@sentry.example.com/1
# SENTRY_DSN=

# Specify a given application environment.
#
# See https://docs.sentry.io/product/sentry-basics/environments/
#
# presence: optional
# type: String
# default: none
# SENTRY_ENVIRONMENT=

# Enable or disable the logging of all the requests of the API.
#
# See https://docs.sentry.io/product/issues/issue-details/breadcrumbs/
#
# presence: optional
# type: positive integer
# default: none
# SENTRY_MAX_BREADCRUMBS=

# Enable or disable the debug mode for Sentry.
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# SENTRY_DEBUG=true

# ===================================
# PHRASE (TRANSLATION PLATFORM)
# ===================================

# The API Key to access phrase
# Create it here: https://app.phrase.com/settings/oauth_access_tokens
# scopes: `read` and `write`
#
# presence: optional
# type: String
# default: none
# PHRASE_API_KEY=xxxxx

# The Phrase webhook secret
#
# presence: optional
# type: String
# default: none
# PHRASE_WEBHOOK_SECRET=xxxxx

# =================
# UPLOAD TRANSLATION TO PHRASE JOB
# =================

# Base URL for generating translation preview link
#
# presence: optional
# type: String
# default: none
# PIX_EDITOR_BASE_URL=

# Enable or disable compression when returning large JSON
#
# presence: optional
# type: Boolean
# default: `undefined` (`false`)
# ALLOW_COMPRESSION_ON_LARGE_JSON=false

# ===================================
# WEBLATE (TRANSLATION PLATFORM)
# ===================================

# Enable/disable managing translations with weblate
#
# presence: optional
# type: Boolean
# default: false
# WEBLATE_IS_ENABLED=xxxxx

# The API base URL to access weblate
#
# presence: optional
# type: String
# default: none
# WEBLATE_API_URL=https://weblate.env.pix.digital

# The API Token to access weblate
#
# presence: optional
# type: String
# default: none
# WEBLATE_API_TOKEN=xxxxx

# The Weblate Project used to upload and download translations
#
# presence: optional
# type: String
# default: none
# WEBLATE_PROJECT=xxxxx

# ============
# SEEDS
# ============

# Number of frameworks dynamically created when seeding database
#
# presence: optional
# type: Number
# default: 2
# SEEDS_CNT_FRAMEWORKS=2

# Number of areas per framework dynamically created when seeding database
#
# presence: optional
# type: Number
# default: 2
# SEEDS_CNT_AREAS=2

# Number of competences per area dynamically created when seeding database
#
# presence: optional
# type: Number
# default: 2
# SEEDS_CNT_COMPETENCES=2

# Number of thematics per competence dynamically created when seeding database
#
# presence: optional
# type: Number
# default: 2
# SEEDS_CNT_THEMATICS=2

# Number of tubes per thematic dynamically created when seeding database
#
# presence: optional
# type: Number
# default: 2
# SEEDS_CNT_TUBES=2

# Created skills until level passed in env in each tube dynamically created when seeding database
#
# presence: optional
# type: Number
# default: 3
# SEEDS_SKILL_LEVEL=3

# Locales used to create data dynamically when seeding database. First locale in list is the primary locale.
# Locales separated by comma, no spaces.
#
# presence: optional
# type: String
# default: fr,en
# SEEDS_LOCALES=fr,en


# ========
# pg-boss CONFIGURATION
# ========

# URL of the PostgreSQL database used for storing jobs
#
# presence: required
# type: Url
# default: none
JOBS_DATABASE_URL=postgresql://postgres@localhost:5444/pix_lcms

# URL of the PostgreSQL database used for API local testing.
#
# presence: required
# type: Url
# default: none
TEST_JOBS_DATABASE_URL=postgresql://postgres@localhost:5444/pix_lcms_test

# Size of database connection pool for pgboss client
#
# presence: optional
# type: positive integer
# default: 2
# sample: PGBOSS_CLIENT_CONNECTION_POOL_MAX_SIZE=10
# PGBOSS_CLIENT_CONNECTION_POOL_MAX_SIZE=

# Size of database connection pool for pgboss worker
#
# presence: optional
# type: positive integer
# default: 15
# sample: PGBOSS_WORKER_CONNECTION_POOL_MAX_SIZE=10
# PGBOSS_WORKER_CONNECTION_POOL_MAX_SIZE=


# Cron of states monitoring job
#
# presence: optional
# type: string
# default: * * * * * (every minute)
# sample: PGBOSS_STATES_MONITORING_JOB_CRON=* * * * *


# Allow async event handling through pg-boss
#
# presence: optional
# type: Boolean
# default: `false`
# sample: START_JOB_IN_WEB_PROCESS=true
START_JOB_IN_WEB_PROCESS=

# ====================
# Oh Dear monitoring
# ====================

# presence: optional
# URL_BROKEN_LINKS_MONITOR_AUTH_API_KEY=
# URL_BROKEN_LINKS_MONITOR_PAGE_SIZE=
