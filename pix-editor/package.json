{
  "name": "pixeditor",
  "version": "4.59.0",
  "private": true,
  "description": "Small description for pixeditor goes here",
  "license": "AGPL-3.0-or-later",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "",
  "scripts": {
    "clean": "rm -rf tmp dist node_modules",
    "build": "STRIP_TEST_SELECTORS=true vite build",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel 'lint:!(fix)'",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:scss": "stylelint app/styles/*.scss",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:js": "eslint . --cache",
    "preinstall": "git config core.hooksPath .githooks || true",
    "lint:js:fix": "npm run lint:js -- --fix",
    "start": "vite",
    "test:ember": "ember exam --path dist --config-file ./testem.js",
    "test:ci": "vite build --mode test && ember exam --path dist --config-file ./testem.js --split=$CIRCLE_NODE_TOTAL --partition=$((1 + CIRCLE_NODE_INDEX))",
    "test": "npm-run-all lint test:ci"
  },
  "devDependencies": {
    "@1024pix/ember-testing-library": "4.0.1",
    "@1024pix/eslint-plugin": "3.0.10",
    "@1024pix/nebulix-ember": "1.3.0",
    "@1024pix/stylelint-config": "5.1.37",
    "@babel/plugin-transform-runtime": "7.29.7",
