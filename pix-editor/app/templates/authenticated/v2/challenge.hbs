<ChallengesProduction::ChallengesProduction
  @skill={{this.model.skill}}
  @challenges={{this.model.challenges}}
  @overview={{this.model.overview}}
/>
<form action="" class="primary-form">
  <PixTextarea
    @id="instruction"
    @value={{this.model.challenge.instruction}}
    readonly
  >
    <:label>Consigne</:label>
  </PixTextarea>
  <PixInput
    @id="type"
    @value={{this.model.challenge.type}}
    readonly
  >
    <:label>Type</:label>
  </PixInput>

  {{#if this.model.challenge.isTextBased}}
    <PixInput
      @id="format"
      @value={{this.model.challenge.format}}
      readonly
    >
      <:label>Format</:label>
    </PixInput>
  {{/if}}
  <PixTextarea
    @id="proposals"
    @value={{this.model.challenge.proposals}}
    readonly
  >
    <:label>Propositions</:label>
  </PixTextarea>
  <PixTextarea
    @id="solution"
    @value={{this.model.challenge.solution}}
    readonly
  >
    <:label>Réponses</:label>
  </PixTextarea>
  {{#if this.model.challenge.illustration}}
    <p>Illustration</p>
    <img src="{{this.model.challenge.illustration.url}}" alt="">
    <PixTextarea
      @id="proposals"
      @value={{this.model.challenge.illustrationAlt}}
      readonly
    >
      <:label>Texte alternatif</:label>
    </PixTextarea>
  {{/if}}
  <p>Tolérance</p>
  <div class="primary-form__tolerance">
    <PixCheckbox
      @checked={{this.model.challenge.t1Status}}
      disabled
    >
      <:label>T1 (espaces/casse/accents)</:label>
    </PixCheckbox>
    <PixCheckbox
      @checked={{this.model.challenge.t2Status}}
      disabled
    >
      <:label>T2 (ponctuation)</:label>
    </PixCheckbox>
    <PixCheckbox
      @checked={{this.model.challenge.t3Status}}
      disabled
    >
      <:label>T3 (distance d'édition)</:label>
    </PixCheckbox>
  </div>
  <PixInput
    @id="embedUrl"
    @value={{this.model.challenge.embedURL}}
    readonly
  >
    <:label>Embed URL</:label>
  </PixInput>
  <PixInput
    @id="embedHeight"
    @value={{this.model.challenge.embedHeight}}
    readonly
  >
    <:label>Hauteur</:label>
  </PixInput>
  <PixInput
    @id="title"
    @value={{this.model.challenge.title}}
    readonly
  >
    <:label>Titre</:label>
  </PixInput>
  <PixInput
    @id="pedagogy"
    @value={{this.model.challenge.pedagogy}}
    readonly
  >
    <:label>Type pédagogie</:label>
  </PixInput>
  <PixInput
    @id="declinable"
    @value={{this.model.challenge.declinable}}
    readonly
  >
    <:label>Déclinable</:label>
  </PixInput>
  <PixCheckbox
    @checked={{this.model.challenge.timer}}
    disabled
  >
    <:label>Timer</:label>
  </PixCheckbox>
  <PixCheckbox
    @checked={{this.model.challenge.focusable}}
    disabled
  >
    <:label>Focus</:label>
  </PixCheckbox>
  <p>Internationalisation</p>
  <PixInput
    @id="locales"
    @value={{this.model.challenge.locales}}
    readonly
  >
    <:label>Langue(s)</:label>
  </PixInput>
  <PixInput
    @id="geography"
    @value={{this.model.challenge.geography}}
    readonly
  >
    <:label>Langue(s)</:label>
  </PixInput>

  <PixInput
    @id="locales"
    @value={{this.model.challenge.contextualizedFields}}
    readonly
  >
    <:label>Champs contextualisés</:label>
  </PixInput>
  <PixInput
    @id="locales"
    @value={{this.model.challenge.id}}
    readonly
  >
    <:label>Id</:label>
  </PixInput>
</form>
