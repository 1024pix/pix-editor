<form class="ui form">
  <div class="fields">
    <div class="twelve wide field">
      <label for="title_tutorial">Titre *</label>
      <Input id="title_tutorial" @type="text" @value={{@tutorial.title}} placeholder="Titre" />
    </div>
    <div class="six wide field">
      <PixSelect
        @placeholder="Langue"
        @options={{this.tutorialLanguageOptions}}
        @onChange={{this.setTutorialLanguage}}
        @value={{this.tutorialLanguage}}
        @hideDefaultOption={{true}}
      >
        <:label>Langue *</:label>
      </PixSelect>
    </div>
  </div>
  <div class="three fields">
    <div class="field">
      <label for="text_tutorial">Lien *</label>
      <Input id="text_tutorial" @type="text" @value={{@tutorial.link}} placeholder="Lien" />
    </div>
    <div class="field" data-test-select-source-for-tutorial>
      <label>Source *</label>
      <PowerSelect
              @searchEnabled={{true}}
              @selected={{@tutorial.source}}
              @search={{this.getSearchSourceResults}}
              @placeholder="Source"
              @onChange={{fn (mut @tutorial.source)}}
              @dropdownClass="search-result tutorial-search"
              @triggerComponent={{ component "power-select/custom-trigger" }}
              @searchMessage=""
              @searchPlaceholder="Rechercher..."
              @loadingMessage="Recherche en cours..." as |result|>
            {{result}}
      </PowerSelect>
    </div>
    <PixSelect
      @placeholder="Licence"
      @options={{this.options.license}}
      @onChange={{fn (mut @tutorial.license)}}
      @value={{@tutorial.license}}
    >
      <:label>Licence</:label>
    </PixSelect>
  </div>
  <div class="three fields">
    <PixSelect
      @placeholder="Format *"
      @options={{this.options.format}}
      @onChange={{fn (mut @tutorial.format)}}
      @value={{@tutorial.format}}
    >
      <:label>Format</:label>
    </PixSelect>
    <div class="field">
      <label for="duration_tutorial">Durée (hh:mm:ss) *</label>
      <Input id="duration_tutorial" @type="text" @value={{@tutorial.duration}} placeholder="Durée (hh:mm:ss)" />
    </div>

    <PixSelect
      @placeholder="Niveau"
      @options={{this.options.level}}
      @onChange={{fn (mut @tutorial.level)}}
      @value={{@tutorial.level}}
    >
      <:label>Niveau</:label>
    </PixSelect>
  </div>
  <div class="three fields">
    <div data-test-tag-search class="field">
      <label>Rechercher tags</label>
      <PowerSelect
        @searchEnabled={{true}}
        @search={{this.getSearchTagsResults}}
        @placeholder="Nom"
        @onChange={{this.selectTag}}
        @dropdownClass="search-result tutorial-search"
        @triggerComponent={{ component "power-select/custom-trigger" }}
        @searchMessage=""
        @searchPlaceholder="Rechercher..."
        @loadingMessage="Recherche en cours..." as |result|>
        <div class="search-title">
          {{#if (eq result.id "create")}}
            {{result.title}} <i class="add icon"></i>
          {{else}}
            {{result.title}}
          {{/if}}
        </div>
        <div class="search-description">
          {{#if result.description}}
            {{result.description}}
          {{/if}}
        </div>
      </PowerSelect>
    </div>
    <div class="twelve wide field">
      {{#if @tutorial.tags.length}}
        <label>Tags</label>
        {{#each @tutorial.tags as |tag|}}
          <div class="ui mini labeled button btn-selected-tag" tabindex="0">
            <div {{on "click" (fn this.unselectTag tag.id)}} class="ui icon button">
              <i class="close icon"></i>
            </div>
            <p class="ui basic label">
              {{tag.title}}
            </p>
          </div>
        {{/each}}
      {{/if}}
    </div>
  </div>
  <div class="fields">
    <div class="field">
      <label>Coup de coeur</label>
      <div {{on "click" this.toggleCrush}} class="ui circular icon button crush">
        <i class="icon red heart {{if @tutorial.crush "" "outline" }}"></i>
      </div>
    </div>
  </div>
  <p>* champ obligatoire</p>
</form>
