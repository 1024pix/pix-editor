<form class="tutorial-form">
  <div class="fields">
    <div class="twelve wide field">
      <label for="title_tutorial">Titre *</label>
      <Input id="title_tutorial" @type="text" @value={{@tutorial.title}} placeholder="Titre" />
    </div>
    <div class="six wide field">
      <PixSelect
        @placeholder="Langue"
        @options={{this.tutorialLanguageOptions}}
        @onChange={{this.setTutorialLanguage}}
        @requiredLabel={{"Champ obligatoire"}}
        @value={{this.tutorialLanguage}}
        @hideDefaultOption={{true}}
      >
        <:label>Langue</:label>
      </PixSelect>
    </div>
  </div>
  <div class="three fields">
    <div class="field">
      <label for="text_tutorial">Lien *</label>
      <Input id="text_tutorial" @type="text" @value={{@tutorial.link}} placeholder="Lien" />
    </div>
    <div class="field" data-test-select-source-for-tutorial>
      <PixSelect
        @className={{"search-result tutorial-search"}}
        @placeholder="Source"
        @options={{this.sourceListOptions}}
        @onChange={{fn (mut @tutorial.source)}}
        @onSearch={{this.getSearchSourceResults}}
        @value={{@tutorial.source}}
        @isSearchable={{true}}
        @searchLabel={{"Rechercher une source"}}
        @searchPlaceholder="Rechercher..."
        @requiredLabel={{"Champ obligatoire"}}
      >
        <:label>Source</:label>
      </PixSelect>
    </div>
    <PixSelect
      @placeholder="Licence"
      @options={{this.formattedLicenseOptionList}}
      @onChange={{fn (mut @tutorial.license)}}
      @value={{@tutorial.license}}
    >
      <:label>Licence</:label>
    </PixSelect>
  </div>
  <div class="three fields">
    <PixSelect
      @placeholder="Format"
      @options={{this.formattedFormatOptionList}}
      @onChange={{fn (mut @tutorial.format)}}
      @value={{@tutorial.format}}
      @requiredLabel={{"Champ obligatoire"}}
      @hideDefaultOption={{true}}
    >
      <:label>Format</:label>
    </PixSelect>
    <div class="field">
      <label for="duration_tutorial">Durée (hh:mm:ss) *</label>
      <Input id="duration_tutorial" @type="text" @value={{@tutorial.duration}} placeholder="Durée (hh:mm:ss)" />
    </div>

    <PixSelect
      @placeholder="Niveau"
      @options={{this.formattedLevelOptionList}}
      @onChange={{fn (mut @tutorial.level)}}
      @value={{@tutorial.level}}
    >
      <:label>Niveau</:label>
    </PixSelect>
  </div>
  <div class="three fields">
    <div data-test-tag-search class="field tutorial-tags-select">
      <PixMultiSelect
        @isSearchable={{true}}
        @onSearch={{this.getSearchTagsResults}}
        @placeholder="cloud clavier ..."
        @onChange={{this.onChangeTags}}
        @values={{this.tutorialTagIds}}
        @emptyMessage="Aucun tag"
        @options={{this.tagListOptions}}
      >
        <:label>Rechercher tags</:label>
        <:default as |option|>
          <div class="search-title">
            {{#if (eq option.value "create")}}
              {{option.label}} <i class="add icon"></i>
            {{else}}
              {{option.label}}
            {{/if}}
          </div>
          <div class="search-description">
            {{#if option.description}}
              {{option.description}}
            {{/if}}
          </div>
        </:default>
      </PixMultiSelect>
    </div>
    <div class="twelve wide field">
      {{#if @tutorial.tags.length}}
        <label>Tags</label>
        <section class="tags">
          {{#each @tutorial.tags as |tag|}}
            <span  class="tag">
              {{tag.title}}
              <PixIconButton
                @iconName="close"
                @triggerAction="{{this.unselectTag tag.id}}"
                @size="small"
                class="delete-tag-button">
              </PixIconButton>
            </span>
          {{/each}}
        </section>
      {{/if}}
    </div>
  </div>
  <div class="fields">
    <div class="field">
      <label>Coup de coeur</label>
      <div {{on "click" this.toggleCrush}} class="ui circular icon button crush">
        <i class="icon red heart {{if @tutorial.crush "" "outline" }}"></i>
      </div>
    </div>
  </div>
  <p>* champ obligatoire</p>
</form>
