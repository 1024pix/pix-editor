<PixModal
  @title={{t 'target_profile.pdf_export.title'}}
  @onCloseButtonClick={{this.closeModal}}
  @showModal={{@showModal}}
>
  <:content>
    <form class="pdf-entries" {{on "submit" this.validate}}>
      <div>
        <PixInput
          @value={{this.title}}
          class="field"
          {{on "input" this.setTitle}}
        >
          <:label>Titre</:label>
        </PixInput>
      </div>
      <div>
        <PixSelect
          @value={{this.selectedLanguage}}
          @options={{this.options.language}}
          @onChange={{this.setLanguage}}
          @hideDefaultOption={{true}}
          class="field"
        >
          <:label>{{t 'target_profile.pdf_export.field.language'}}</:label>
        </PixSelect>
      </div>
    </form>
  </:content>
  <:footer>
    <PixButton
      @backgroundColor="transparent-light"
      @isBorderVisible={{true}}
      @triggerAction={{this.closeModal}}
    >
      {{t 'common.cancel'}}
    </PixButton>
    <PixButton
      @triggerAction={{this.validate}}
      @iconBefore="check"
    >
      {{t 'common.validate'}}
    </PixButton>
  </:footer>
</PixModal>