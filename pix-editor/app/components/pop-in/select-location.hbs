<PixModal
  @title={{this.titleModal}}
  @onCloseButtonClick={{this.closeModal}}
  @showModal={{@showModal}}
>
  <:content>
    {{#if @showModal}}
      <Form::SelectLocation
        @variant={{@variant}}
        @theme={{@theme}}
        @tube={{@tube}}
        @skill={{@skill}}
        @setIsSubmitable={{this.setIsSubmitable}}
        @onSubmit={{this.onSubmit}}
      />
    {{/if}}
  </:content>
  <:footer>
    <PixButton
      @backgroundColor="transparent-light"
      @isBorderVisible={{true}}
      @triggerAction={{this.closeModal}}
    >
      {{t 'common.cancel'}}
    </PixButton>
    <PixButton
      data-test-move-action
      @isDisabled={{not this.enableMoveActionButton}}
      @type="submit"
      form="form-select-location"
    >
      <i class="checkmark icon"></i>
      {{this.titleButtonAction}}
    </PixButton>
  </:footer>
</PixModal>